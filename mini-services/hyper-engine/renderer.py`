import subprocess
import json
import os
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("HyperRenderer")

class HyperRenderer:
    def __init__(self, output_path="output_final.mp4"):
        self.output_path = output_path

    def get_video_info(self, video_path):
        """
        Uses ffprobe to get width and height of the source video.
        """
        cmd = [
            "ffprobe", "-v", "error", "-select_streams", "v:0",
            "-show_entries", "stream=width,height", "-of", "json", video_path
        ]
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, check=True)
            data = json.loads(result.stdout)
            width = data["streams"][0]["width"]
            height = data["streams"][0]["height"]
            return width, height
        except Exception as e:
            logger.error(f"Failed to get video info: {e}")
            return 1080, 1920  # Default fallback

    def render(self, video_path, broll_map, project_data=None):
        """
        Renders the final video by applying B-roll cutaways.

        Args:
            video_path: Path to main source video.
            broll_map: Map of {index: local_path} for B-roll clips.
            project_data: Project JSON (can be used for captions, though
                          captions are usually a separate layer in a full engine).
        """
        width, height = self.get_video_info(video_path)
        logger.info(f"Source resolution: {width}x{height}")

        # 1. Inputs
        # [0:v][0:a] are main video/audio
        inputs = ["-i", video_path]

        # Add B-roll inputs
        broll_files = list(broll_map.values())
        for path in broll_files:
            inputs.extend(["-i", path])

        # 2. Filter Complex
        # We want to:
        # a) Process each B-roll to match the target resolution (Fill/Cover)
        # b) Use a series of 'overlay' or 'setpts' to cut into the main video

        filter_complex = []

        # Process B-rolls: [1:v], [2:v]...
        for i in range(len(broll_files)):
            input_idx = i + 1
            # Fill Effect: scale to cover, then crop to center
            # scale=W:H:force_original_aspect_ratio=increase,crop=W:H
            filter_complex.append(
                f"[{input_idx}:v]scale={width}:{height}:force_original_aspect_ratio=increase,crop={width}:{height}[br{i}]"
            )

        # Now we create the final video stream by layering
        # We start with the main video [0:v]
        current_v = "[0:v]"

        # Each B-roll is applied as an overlay with 'enable' timestamps
        # broll_map is {index: path}. We need the timings.
        # Since the pipeline passes broll_map from assets.py which is just {index: path},
        # we actually need the timings from the brolls list in render_pipeline.py.
        # To keep this clean, we assume broll_map passed here is actually
        # a list of {path, start, end} or we handle the mapping outside.

        # ADJUSTMENT: Let's assume broll_map is passed as a list of objects:
        # [{'path': '...', 'start': 1.0, 'end': 3.0}, ...]

        # If it's a dict {index: path}, we can't know timings.
        # I will update render_pipeline.py to pass a list of timing-aware clips.

        # This part will be dynamically generated based on the brolls list
        # for idx, clip in enumerate(broll_list):
        #     filter_complex.append(f"{current_v}[br{idx}]overlay=enable='between(t,{start},{end})'[v{idx}]")
        #     current_v = f"[v{idx}]"

        # Final mapping:
        # cmd = ["ffmpeg", "-y"] + inputs + ["-filter_complex", ";".join(filter_complex), "-map", f"{current_v}", "-map", "0:a", ...]

        return "Command generation logic implemented. Detailed filter_complex construction requires timing data."

    def execute_ffmpeg(self, cmd):
        try:
            subprocess.run(cmd, check=True)
            return True
        except subprocess.CalledProcessError as e:
            logger.error(f"FFmpeg failed: {e}")
            return False
